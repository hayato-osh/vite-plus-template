{
  "devDependencies": {
    "@tailwindcss/vite": "catalog:tailwind",
    "tailwindcss": "catalog:tailwind"
  },
  "edit": {
    "vite.config.ts": [
      [
        "import react from \"@vitejs/plugin-react\";",
        "import tailwindcss from \"@tailwindcss/vite\";\nimport react from \"@vitejs/plugin-react\";"
      ],
      ["react()", "react(), tailwindcss()"]
